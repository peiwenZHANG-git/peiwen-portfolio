# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.log

# local agent and review output
/.codex/
/.claude/settings.local.json
/screenshots/
/visualizations/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw Pixabay downloads; the site uses the processed files in public/assets/audio (scripts/prepare-audio.sh)
/design-assets/audio/incoming/

# the full 25 MB source font; the site uses the subset from scripts/prepare-zh-font.py
/design-assets/fonts/*.ttf
