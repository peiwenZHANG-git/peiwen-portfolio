# Copy this file to .env.local for local development, and add the same variable
# in your deployment platform's project settings (e.g. Vercel → Settings → Environment
# Variables) for it to work in production.

# Access key for https://web3forms.com — powers the "Send" button on the About page's
# postcard (see PostcardNote in app/about/about-page.tsx). It's a public/client-side key
# by design (Web3Forms is meant to be called straight from the browser and has its own
# spam protection), so NEXT_PUBLIC_ is correct here — this is not a secret.
#
# Get one free at https://web3forms.com: enter the email address that should receive the
# postcards, and Web3Forms emails you an access key. Paste it below.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
